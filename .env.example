# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Audio Settings
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=480

# Noise Reduction Settings
ENABLE_NOISE_REDUCTION=true
# Noise reduction strength: 0.0 (none) to 1.0 (maximum)
# Default: 0.8 (80% reduction, preserves voice naturalness)
# Lower values (0.5-0.7): Lighter noise reduction, more natural voice
# Higher values (0.9-1.0): Aggressive reduction, may affect voice quality
NOISE_REDUCTION_STRENGTH=0.8

# Hotkey Configuration (use keyboard module syntax)
# Examples: 'pause', 'ctrl+shift+space', 'f13'
HOTKEY=pause

# AI Processing Settings
# Set to 'true' to enable AI cleanup, 'false' for raw transcription only
ENABLE_AI_CLEANUP=true

# Model Configuration
WHISPER_MODEL=whisper-large-v3
LLM_MODEL=llama-3.1-8b-instant

# Application Settings
DEBUG=false
AUTO_START=false
