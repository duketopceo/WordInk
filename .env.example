# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Audio Settings
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=480

# Hotkey Configuration (use keyboard module syntax)
# Examples: 'pause', 'ctrl+shift+space', 'f13'
HOTKEY=pause

# AI Processing Settings
# Set to 'true' to enable AI cleanup, 'false' for raw transcription only
ENABLE_AI_CLEANUP=true

# Model Configuration
WHISPER_MODEL=whisper-large-v3
LLM_MODEL=llama-3.1-8b-instant

# Application Settings
DEBUG=true
AUTO_START=false
