# Maintainer: WordInk contributors
#
# Not related to extra/hex (the hex dump tool): this is the WordInk voice
# dictation app, so it neither provides nor conflicts with it.
#
# A template: render-pkgbuild.sh fills in the version, the release tag and the
# tarball checksums from a release's SHA256SUMS. The sources are the release's
# wordink-<version>-linux-<x64|arm64>.tar.gz, which hold the executable, the
# desktop entry, the icons, the systemd user unit and the license.
pkgname=wordink-bin
pkgver=@PKGVER@
_version=@VERSION@
pkgrel=1
pkgdesc='WordInk voice dictation, based on Hex by Anomaly: hold a key, speak, and it types (Linux beta)'
arch=('x86_64' 'aarch64')
url='https://github.com/duketopceo/WordInk'
license=('MIT')
# Linked: alsa-lib, gcc-libs, glibc, vulkan-icd-loader. Loaded at runtime: the
# X11/Wayland/xkbcommon client libraries. The release links no system BLAS.
depends=(
  'alsa-lib' 'curl' 'gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxcursor'
  'libxi' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland'
)
optdepends=(
  'wl-clipboard: paste on Wayland'
  'wtype: paste on Wayland'
  'vulkan-driver: GPU transcription'
  'wireplumber: mute output while dictating (or libpulse for pactl)'
  'xdg-utils: open links from voice commands'
)
options=('!strip' '!debug')
install=wordink-bin.install
_release="https://github.com/duketopceo/WordInk/releases/download/desktop-v${_version}"
source_x86_64=("${_release}/wordink-${_version}-linux-x64.tar.gz")
source_aarch64=("${_release}/wordink-${_version}-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA256_X64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  local target=x64
  [ "$CARCH" = aarch64 ] && target=arm64
  cd "wordink-${_version}-linux-${target}"
  install -Dm755 wordink "$pkgdir/usr/bin/wordink"
  sed 's#@HEX_BIN@#/usr/bin/wordink#g' io.github.duketopceo.wordink.desktop > "$srcdir/wordink.desktop"
  install -Dm644 "$srcdir/wordink.desktop" "$pkgdir/usr/share/applications/io.github.duketopceo.wordink.desktop"
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "icons/hicolor/${size}x${size}/apps/io.github.duketopceo.wordink.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.github.duketopceo.wordink.png"
  done
  install -Dm644 wordink.service "$pkgdir/usr/lib/systemd/user/wordink.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
