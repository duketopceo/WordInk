[Unit]
Description=WordInk gateway: OpenAI-compatible transcription with provider fallback (127.0.0.1:8941)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/wordink-gateway-run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
