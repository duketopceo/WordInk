#!/bin/sh
# wordink-gateway-run: start `wordink-gateway serve` with provider keys pulled from omaseal into its
# environment, so no key ever lands on disk (the same pattern as a voxtype-daemon wrapper).
#
# Key map, one `ENV_NAME=service/account` per line (names only, never key values):
#   ${XDG_CONFIG_HOME:-$HOME/.config}/wordink/gateway-keys
# e.g.
#   GROQ_API_KEY=groq/default
#   GROQ_API_KEY_2=Groq-Hermes-API
set -eu

MAP="${XDG_CONFIG_HOME:-$HOME/.config}/wordink/gateway-keys"
BIN="${WORDINK_GATEWAY_BIN:-wordink-gateway}"

if [ -f "$MAP" ]; then
  while IFS='=' read -r name ref; do
    case "$name" in '' | \#*) continue ;; esac
    service=${ref%%/*}
    account=${ref#*/}
    if value=$(omaseal get "$service" "$account" 2>/dev/null); then
      value=$(printf '%s' "$value" | tr -d '[:space:]')
      export "$name=$value"
    else
      echo "wordink-gateway-run: omaseal has no $service/$account for $name; that provider is skipped" >&2
    fi
  done < "$MAP"
fi

exec "$BIN" serve "$@"
