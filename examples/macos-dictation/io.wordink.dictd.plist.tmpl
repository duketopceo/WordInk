<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by examples/macos-dictation/install.sh. Holds no secrets: the Groq key lives in the login Keychain. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.wordink.dictd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LAUNCHER__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.log</string>
</dict>
</plist>
