{
  "name": "@wordink/local",
  "version": "1.0.0",
  "description": "Offline WordInk speech engine: Moonshine via transformers.js in a Web Worker (WebGPU, WASM fallback).",
  "license": "MIT",
  "homepage": "https://duketopceo.github.io/WordInk/",
  "keywords": [
    "dictation",
    "speech-to-text",
    "offline",
    "moonshine",
    "transformers.js",
    "webgpu",
    "wasm",
    "wordink"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/WordInk.git",
    "directory": "packages/local"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependencies": {
    "@wordink/core": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@wordink/core": "workspace:*",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
