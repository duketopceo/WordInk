{
  "name": "@wordink/react",
  "version": "0.0.0",
  "description": "React bindings for WordInk dictation: the useDictation hook and a typed <WordInkMic> wrapper for <wordink-mic>.",
  "license": "MIT",
  "homepage": "https://duketopceo.github.io/WordInk/",
  "keywords": [
    "dictation",
    "speech-to-text",
    "voice",
    "react",
    "react-hook",
    "push-to-talk",
    "wordink"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/WordInk.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@wordink/core": "workspace:*",
    "@wordink/web": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
