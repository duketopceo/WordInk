{
  "name": "@wordink/web",
  "version": "0.1.0",
  "description": "<wordink-mic>: a drop-in push-to-talk dictation web component for any input, textarea or contenteditable.",
  "license": "MIT",
  "homepage": "https://duketopceo.github.io/WordInk/",
  "keywords": [
    "dictation",
    "speech-to-text",
    "voice",
    "web-component",
    "custom-element",
    "push-to-talk",
    "microphone",
    "wordink"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cdn": "./dist/wordink-web.cdn.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/WordInk.git",
    "directory": "packages/web"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-cdn.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@wordink/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
