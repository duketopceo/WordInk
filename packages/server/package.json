{
  "name": "@wordink/server",
  "version": "0.0.0",
  "description": "Fail-closed credential relay for WordInk: forwards Groq audio and mints short-lived OpenAI and Deepgram credentials so provider keys never reach the browser.",
  "license": "MIT",
  "homepage": "https://duketopceo.github.io/WordInk/",
  "keywords": [
    "dictation",
    "speech-to-text",
    "credentials",
    "relay",
    "cloudflare-workers",
    "groq",
    "openai",
    "deepgram",
    "wordink"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "wordink-gateway": "dist/bin/wordink-gateway.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/WordInk.git",
    "directory": "packages/server"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
